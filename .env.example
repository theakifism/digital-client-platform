# Copy this file to .env.local and fill in the values.
# .env.local is private and is never committed to git.

# From Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" key (newer dashboards call it the "publishable" key). Safe to use in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Usernames are turned into hidden addresses like ravi-sharma@example.com. No email is ever sent there.
# If Supabase refuses to create a user because the address looks invalid, use your company's real domain here.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=example.com

# The public address of the site. Local testing uses http://localhost:3000. On the live site it MUST be the real https address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: the company name shown on the site and in e-mails (default: Orion Teleservices). Also set it on the host.
# The logo is a picture (public/logo.png) and has to be replaced separately if the spelling changes.
# NEXT_PUBLIC_BRAND_NAME=

# Optional: a sample card shown on the home page, and a contact e-mail shown on the contact page.
# NEXT_PUBLIC_SAMPLE_CARD=demo-card
# NEXT_PUBLIC_CONTACT_EMAIL=

# Needed from Milestone 4 onward. SECRET: server only, never put NEXT_PUBLIC_ in front of it.
# SUPABASE_SERVICE_ROLE_KEY=

# Spam check (Cloudflare Turnstile). Set BOTH before going live: with no secret key the live forms are blocked.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Only if you really want the live site WITHOUT the spam check (not recommended):
# TURNSTILE_DISABLED=true

# E-mail through Resend (card requests, messages to clients, admin alerts, weekly numbers).
# RESEND_API_KEY=
# RESEND_FROM=Orion Cards <cards@yourdomain.com>
# REQUEST_NOTIFY_EMAIL=you@yourcompany.com
# At most this many "you got a message" e-mails per day for ALL cards together (default 80, keeps room for your own alerts).
# LEAD_EMAIL_DAILY_CAP=80

# Scheduled GitHub jobs (admin e-mail check, weekly client numbers). 24 or more random characters. Same value as the GitHub secret.
# CRON_SECRET=

# Rate limits count visitors by the address your host reports. Netlify: leave this out (default x-nf-client-connection-ip).
# On Cloudflare Pages use cf-connecting-ip.
# CLIENT_IP_HEADER=

# Set to true at BUILD time to make the Content-Security-Policy block instead of only report (see MILESTONE-11.md).
# CSP_ENFORCE=true

# Milestone 18, OPTIONAL: move photos to Cloudflare R2 (see MILESTONE-18.md). Leave these out to keep photos in Supabase Storage.
# All SECRET except R2_PUBLIC_URL, which is public by design. Set all five or none.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# The public address of the bucket (the pub-xxxx.r2.dev address while testing, your own photos.yourcompany.com for the launch). No slash at the end.
# R2_PUBLIC_URL=
