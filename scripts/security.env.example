# Copy this file to  .env.security  (in the project folder, next to .env.local) and fill it in.
# .env.security is ignored by git, so it never goes to GitHub. Never put real clients' logins here.
SEC_USER_A=secdemo-a
SEC_PASS_A=the-password-of-test-client-a
SEC_USER_B=secdemo-b
SEC_PASS_B=the-password-of-test-client-b
# Optional: the name of a card that is switched off (the demo one from Milestone 2)
SEC_OFF_SLUG=demo-off
# Optional: your admin login, which makes the "cannot read" checks more meaningful
# SEC_USER_ADMIN=admin
# SEC_PASS_ADMIN=your-admin-password
